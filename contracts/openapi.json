{
  "openapi": "3.1.0",
  "info": {
    "title": "Manifest API",
    "description": "Upload a shipment's document pack, then poll its processing status. Reviewer workflows are on\nthe GraphQL endpoint at `/graphql`.\n\n## Uploads\n1. `POST /v1/shipments` creates a shipment.\n2. `POST /v1/shipments/{shipment_id}/documents` returns presigned URLs, one per part; `PUT`\n   each byte range straight to storage and keep each response's `ETag`.\n3. `POST /v1/shipments/{shipment_id}/documents/{document_id}:finalize` with the ETags\n   queues processing (202). Poll `GET /v1/shipments/{shipment_id}`.\n\n## Idempotency\nEvery POST requires an `Idempotency-Key` header. Retrying with the same key and body returns\nthe original response (with `Idempotent-Replayed: true`) instead of repeating the action.\nFailed requests are not remembered, so retry them with the same key.\n\n## Backpressure\n`:finalize` answers 429 with `Retry-After` (seconds) when too many pages are waiting. Nothing\nis queued; retry after the delay with the same key.\n\n## Pagination\nLists are keyset-paginated. Pass `next_cursor` back as `cursor`; treat it as opaque.\n\n## Errors\nEvery 4xx and 5xx body is `application/problem+json` (RFC 9457). `type` is\n`https://manifest.example/problems/<slug>`, or `about:blank` when the status says it all.\n\n| slug | status | title |\n|---|---|---|\n| `validation-error` | 422 | Request is not valid |\n| `idempotency-key-missing` | 400 | Idempotency-Key header is required |\n| `idempotency-key-reused` | 422 | Idempotency-Key was already used for a different request |\n| `idempotency-key-in-flight` | 409 | A request with this Idempotency-Key is still in progress |\n| `invalid-cursor` | 400 | Pagination cursor is not valid |\n| `not-found` | 404 | Resource not found |\n| `conflict` | 409 | Request conflicts with the current state of the resource |\n| `overloaded` | 429 | Too much work is pending; retry later |\n| `not-implemented` | 501 | Not implemented yet |\n| `internal-error` | 500 | Internal server error |\n",
    "version": "0.1.0"
  },
  "paths": {
    "/v1/shipments": {
      "post": {
        "tags": [
          "shipments"
        ],
        "summary": "Create Shipment",
        "description": "Create an empty shipment to attach documents to.",
        "operationId": "create_shipment",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "description": "Client-generated unique key (a UUID is ideal). Retrying with the same key and body returns the original response instead of repeating the side effect.",
              "title": "Idempotency-Key"
            },
            "description": "Client-generated unique key (a UUID is ideal). Retrying with the same key and body returns the original response instead of repeating the side effect."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ShipmentCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Shipment created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Shipment"
                }
              }
            },
            "headers": {
              "Location": {
                "description": "URL of the new resource.",
                "schema": {
                  "type": "string"
                }
              },
              "Idempotent-Replayed": {
                "description": "`true` when this is the stored response to an earlier identical request.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "`Idempotency-Key` header missing (`idempotency-key-missing`).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Another request with this `Idempotency-Key` is still running.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Body failed validation, or the `Idempotency-Key` was used for a different request.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "shipments"
        ],
        "summary": "List Shipments",
        "description": "List shipments, newest first, with keyset pagination.",
        "operationId": "list_shipments",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "Page size.",
              "default": 25,
              "title": "Limit"
            },
            "description": "Page size."
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 512
                },
                {
                  "type": "null"
                }
              ],
              "description": "`next_cursor` from the previous page.",
              "title": "Cursor"
            },
            "description": "`next_cursor` from the previous page."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShipmentPage"
                }
              }
            }
          },
          "400": {
            "description": "`cursor` is malformed or from another listing (`invalid-cursor`).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "`limit` out of range.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/shipments/{shipment_id}": {
      "get": {
        "tags": [
          "shipments"
        ],
        "summary": "Get Shipment",
        "description": "A shipment with the processing status of each document and each page.",
        "operationId": "get_shipment",
        "parameters": [
          {
            "name": "shipment_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Shipment Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShipmentDetail"
                }
              }
            }
          },
          "404": {
            "description": "No such shipment.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "`shipment_id` is not a UUID.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/shipments/{shipment_id}/documents": {
      "post": {
        "tags": [
          "documents"
        ],
        "summary": "Register Document",
        "description": "Register a document and get presigned URLs for a multipart upload straight to storage.",
        "operationId": "register_document",
        "parameters": [
          {
            "name": "shipment_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Shipment Id"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "description": "Client-generated unique key (a UUID is ideal). Retrying with the same key and body returns the original response instead of repeating the side effect.",
              "title": "Idempotency-Key"
            },
            "description": "Client-generated unique key (a UUID is ideal). Retrying with the same key and body returns the original response instead of repeating the side effect."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DocumentCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Document registered; upload each part to its presigned URL.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentUpload"
                }
              }
            },
            "headers": {
              "Location": {
                "description": "URL of the new resource.",
                "schema": {
                  "type": "string"
                }
              },
              "Idempotent-Replayed": {
                "description": "`true` when this is the stored response to an earlier identical request.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "`Idempotency-Key` header missing (`idempotency-key-missing`).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No such shipment.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Shipment no longer accepts documents, or the `Idempotency-Key` is in use.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Body failed validation, or the `Idempotency-Key` was used for a different request.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/shipments/{shipment_id}/documents/{document_id}:finalize": {
      "post": {
        "tags": [
          "documents"
        ],
        "summary": "Finalize Document",
        "description": "Complete the upload and queue the document for processing.",
        "operationId": "finalize_document",
        "parameters": [
          {
            "name": "shipment_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Shipment Id"
            }
          },
          {
            "name": "document_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Document Id"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "description": "Client-generated unique key (a UUID is ideal). Retrying with the same key and body returns the original response instead of repeating the side effect.",
              "title": "Idempotency-Key"
            },
            "description": "Client-generated unique key (a UUID is ideal). Retrying with the same key and body returns the original response instead of repeating the side effect."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DocumentFinalize"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Upload completed and processing queued.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FinalizeAccepted"
                }
              }
            },
            "headers": {
              "Location": {
                "description": "Poll this shipment for per-document and per-page status.",
                "schema": {
                  "type": "string"
                }
              },
              "Idempotent-Replayed": {
                "description": "`true` when this is the stored response to an earlier identical request.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "`Idempotency-Key` header missing (`idempotency-key-missing`).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No such shipment or document.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Document already finalized or its parts don't match the upload, or the `Idempotency-Key` is in use.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Body failed validation, or the `Idempotency-Key` was used for a different request.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Too many pages pending (`overloaded`). Nothing was queued.",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying with the same Idempotency-Key.",
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CompletedPart": {
        "properties": {
          "part_number": {
            "type": "integer",
            "maximum": 10000.0,
            "minimum": 1.0,
            "title": "Part Number"
          },
          "etag": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Etag"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "part_number",
          "etag"
        ],
        "title": "CompletedPart"
      },
      "Document": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "filename": {
            "type": "string",
            "title": "Filename"
          },
          "content_type": {
            "$ref": "#/components/schemas/UploadContentType"
          },
          "size_bytes": {
            "type": "integer",
            "title": "Size Bytes"
          },
          "kind": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DocumentKind"
              },
              {
                "type": "null"
              }
            ],
            "description": "Null until the document is classified."
          },
          "status": {
            "$ref": "#/components/schemas/DocumentStatus"
          },
          "page_count": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Page Count",
            "description": "Null until the document is split into pages."
          },
          "extraction_schema_version": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Extraction Schema Version",
            "description": "Schema version of the current extraction; null before extraction."
          },
          "pages": {
            "items": {
              "$ref": "#/components/schemas/DocumentPage"
            },
            "type": "array",
            "title": "Pages"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "filename",
          "content_type",
          "size_bytes",
          "kind",
          "status",
          "page_count",
          "extraction_schema_version",
          "pages",
          "created_at",
          "updated_at"
        ],
        "title": "Document"
      },
      "DocumentCreate": {
        "properties": {
          "filename": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Filename"
          },
          "content_type": {
            "$ref": "#/components/schemas/UploadContentType"
          },
          "size_bytes": {
            "type": "integer",
            "maximum": 104857600.0,
            "exclusiveMinimum": 0.0,
            "title": "Size Bytes"
          },
          "sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sha256",
            "description": "Hex SHA-256 of the whole file. When given, it is verified on finalize."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "filename",
          "content_type",
          "size_bytes"
        ],
        "title": "DocumentCreate"
      },
      "DocumentFinalize": {
        "properties": {
          "parts": {
            "items": {
              "$ref": "#/components/schemas/CompletedPart"
            },
            "type": "array",
            "maxItems": 10000,
            "minItems": 1,
            "title": "Parts",
            "description": "Every uploaded part, with the ETag its PUT returned."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "parts"
        ],
        "title": "DocumentFinalize"
      },
      "DocumentKind": {
        "type": "string",
        "enum": [
          "commercial_invoice",
          "packing_list",
          "bill_of_lading",
          "other"
        ],
        "title": "DocumentKind"
      },
      "DocumentPage": {
        "properties": {
          "page_number": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Page Number"
          },
          "status": {
            "$ref": "#/components/schemas/PageStatus"
          },
          "text_source": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TextSource"
              },
              {
                "type": "null"
              }
            ],
            "description": "Null until the page's text is extracted."
          },
          "attempts": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Attempts",
            "description": "Processing attempts so far. Failed pages are retried individually."
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error",
            "description": "Last failure reason while `status` is `failed`."
          }
        },
        "type": "object",
        "required": [
          "page_number",
          "status",
          "text_source",
          "attempts",
          "error"
        ],
        "title": "DocumentPage"
      },
      "DocumentStatus": {
        "type": "string",
        "enum": [
          "awaiting_upload",
          "queued",
          "processing",
          "extracted",
          "partially_extracted",
          "failed"
        ],
        "title": "DocumentStatus"
      },
      "DocumentUpload": {
        "properties": {
          "document": {
            "$ref": "#/components/schemas/Document"
          },
          "upload": {
            "$ref": "#/components/schemas/MultipartUpload"
          }
        },
        "type": "object",
        "required": [
          "document",
          "upload"
        ],
        "title": "DocumentUpload"
      },
      "FinalizeAccepted": {
        "properties": {
          "job_id": {
            "type": "string",
            "format": "uuid",
            "title": "Job Id",
            "description": "Pipeline run started for this document."
          },
          "document_id": {
            "type": "string",
            "format": "uuid",
            "title": "Document Id"
          },
          "status": {
            "$ref": "#/components/schemas/DocumentStatus"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "document_id",
          "status"
        ],
        "title": "FinalizeAccepted"
      },
      "MultipartUpload": {
        "properties": {
          "upload_id": {
            "type": "string",
            "title": "Upload Id"
          },
          "part_size_bytes": {
            "type": "integer",
            "title": "Part Size Bytes"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At",
            "description": "The presigned URLs stop working at this time."
          },
          "parts": {
            "items": {
              "$ref": "#/components/schemas/UploadPart"
            },
            "type": "array",
            "title": "Parts"
          }
        },
        "type": "object",
        "required": [
          "upload_id",
          "part_size_bytes",
          "expires_at",
          "parts"
        ],
        "title": "MultipartUpload"
      },
      "PageStatus": {
        "type": "string",
        "enum": [
          "pending",
          "processing",
          "extracted",
          "failed"
        ],
        "title": "PageStatus"
      },
      "Problem": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type",
            "description": "Problem type URI; `about:blank` when the status says it all."
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "status": {
            "type": "integer",
            "title": "Status"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "instance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Instance",
            "description": "Path of the request that failed."
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ValidationIssue"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errors",
            "description": "Individual failures, on `validation-error` and friends."
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "type",
          "title",
          "status"
        ],
        "title": "Problem",
        "description": "RFC 9457 problem details. Clients must ignore extension members they don't know."
      },
      "Shipment": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "reference": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reference"
          },
          "status": {
            "$ref": "#/components/schemas/ShipmentStatus"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "reference",
          "status",
          "created_at",
          "updated_at"
        ],
        "title": "Shipment"
      },
      "ShipmentCreate": {
        "properties": {
          "reference": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Reference",
