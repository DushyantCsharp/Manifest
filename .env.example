# Local development defaults — match infra/compose.yaml. Copy to .env and adjust.

# Host ports (compose). Defaults avoid 5432/8000, which are commonly taken.
POSTGRES_PORT=5440
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
API_PORT=8010

# Application
MANIFEST_DB_URL=postgresql+asyncpg://manifest:manifest@localhost:5440/manifest
MANIFEST_BROKER_URL=amqp://manifest:manifest@localhost:5672//
MANIFEST_REDIS_URL=redis://localhost:6379/0
MANIFEST_S3_ENDPOINT_URL=http://localhost:9000
MANIFEST_S3_BUCKET=manifest-documents
MANIFEST_S3_ACCESS_KEY=manifest
MANIFEST_S3_SECRET_KEY=manifest-secret
# Where clients reach storage for presigned uploads (default: MANIFEST_S3_ENDPOINT_URL).
# MANIFEST_S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
# Backpressure: finalize answers 429 + Retry-After while this many pages are pending.
# MANIFEST_PENDING_PAGES_HIGH_WATER=2000

# Telemetry (manifest_telemetry): OTLP over HTTP to the collector; standard OTEL_* variables.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SDK_DISABLED=true                  # no traces or metrics at all
# OTEL_METRIC_EXPORT_INTERVAL=15000       # milliseconds
# MANIFEST_ENVIRONMENT=local              # deployment.environment.name on every signal
# Prompts and model answers on gen_ai spans: personal data, so off unless you need them.
# OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false
# The monitor (make monitor): management API for queue depths; window for the auto-approve ratio.
# MANIFEST_RABBITMQ_API_URL=http://localhost:15672/api
# MANIFEST_AUTO_APPROVE_WINDOW_MINUTES=60

# LLM provider (libs/llm only). With no key, page extraction is unwired (pages park in the DLQ).
ANTHROPIC_API_KEY=
# MANIFEST_LLM_MODEL=claude-sonnet-5-5
# MANIFEST_LLM_EFFORT=low            # low | medium | high | xhigh | max (thinking depth and cost)
# Replay recorded answers instead of calling the model (replay | record | new):
# MANIFEST_LLM_CASSETTES=evals/cassettes/clean-0001
# MANIFEST_LLM_CASSETTE_MODE=replay
# MANIFEST_LLM_REPLAY_LATENCY=false      # true: each replay takes as long as the recorded call
# MANIFEST_HS_ENABLED=true               # false: no HS walk; lines route to review (HS_UNCERTAIN)
# MANIFEST_HS_RETRIEVALS=                # replay HS retrieval from recordings (load tests)
# MANIFEST_HS_RETRIEVAL_MODE=replay      # replay | record | new
# Embeddings for HS retrieval (make hs-index).
VOYAGE_API_KEY=
# Calibrators to score confidences with (libs/domain/.../calibrators/<name>-v<N>.json). Unset:
# raw scores, and nothing auto-approves. One fitted on oracle answers never auto-approves.
# MANIFEST_EXTRACTION_CALIBRATOR=extraction-v2
# MANIFEST_HS_CALIBRATOR=hs-v2
