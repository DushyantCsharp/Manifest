          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (http_method, http_target, http_status_code) (rate(http_server_duration_milliseconds_count{deployment_environment_name=~\"$env\"}[$__rate_interval]))",
          "legendFormat": "{{http_method}} {{http_target}} {{http_status_code}}",
          "range": true
