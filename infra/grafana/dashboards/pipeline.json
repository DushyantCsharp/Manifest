    {
      "type": "timeseries",
      "title": "Dead-letter queues",
      "description": "Parked messages per DLQ. Alert DeadLetterQueueGrowing fires when one grows over 10 minutes; inspect with `make dlq`.",
      "datasource": {
        "type": "prometheus",
