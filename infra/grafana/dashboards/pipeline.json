    {
      "type": "table",
      "title": "Recent finalize requests (Tempo)",
      "description": "Each finalize request's trace carries the whole document: the published classify task, every page_extract of the chord, each page's gen_ai span, reconcile. Click a trace ID to open it.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "limit": 20,
          "tableType": "traces",
          "query": "{ name =~ \".*:finalize\" }"
