    {
      "type": "timeseries",
      "title": "Model calls per minute by admission",
      "description": "rate_limiter_wait_seconds_count by outcome: admitted at once, waited in-process (short), deferred (task re-queued with a countdown, no retry spent).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (outcome) (rate(rate_limiter_wait_seconds_count{deployment_environment_name=~\"$env\"}[$__rate_interval])) * 60",
          "legendFormat": "{{outcome}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 2,
