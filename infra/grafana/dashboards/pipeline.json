    {
      "type": "timeseries",
      "title": "Wait imposed (p95)",
      "description": "rate_limiter_wait_seconds p95 by outcome: how long the bucket held calls back.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, outcome) (rate(rate_limiter_wait_seconds_bucket{deployment_environment_name=~\"$env\", outcome!=\"admitted\"}[$__rate_interval])))",
          "legendFormat": "{{outcome}}",
          "range": true
        }
